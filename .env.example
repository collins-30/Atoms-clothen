# Copy this file to .env for local development, and add the same names in
# Vercel › Project › Settings › Environment Variables for the live store.
# Never commit real values.

# ── Database (MySQL) ────────────────────────────────────────────────────────
# Local:  mysql://root:password@localhost:3306/fashion_store
# Live (TiDB Cloud Starter, copy the "Prisma" string from Connect and keep
# sslaccept=strict):  mysql://USER:PASSWORD@HOST:4000/fashion_store?sslaccept=strict
DATABASE_URL=

# ── Site address ────────────────────────────────────────────────────────────
# Used in emails, password-reset links and Stripe redirects. No trailing slash.
# Local: http://localhost:3000   Live: https://your-project.vercel.app (or your domain)
NEXT_PUBLIC_APP_URL=

# Time zone for seasonal themes, e.g. Europe/Istanbul (default UTC).
STORE_TIMEZONE=Europe/Istanbul

# ── Sign-in (Auth.js) ───────────────────────────────────────────────────────
# A long random secret: run `npx auth secret` or `openssl rand -base64 33`.
# Use a different one for the live store than for local.
AUTH_SECRET=
# Google sign-in (Google Cloud Console › Credentials › OAuth client).
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only used by `npx prisma db seed` to create/update the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Test keys start sk_test_, live keys sk_live_.
STRIPE_SECRET_KEY=
# From Stripe › Developers › Webhooks, endpoint <NEXT_PUBLIC_APP_URL>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "JAMAS <orders@yourdomain.com>"
EMAIL_FROM=
# Where new-order notifications go (comma-separate several).
ADMIN_NOTIFY_EMAIL=

# ── Photo & video storage (Cloudflare R2) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket (r2.dev link or custom domain), no trailing slash.
# Needed at build time too: images from this address are allowed in next.config.ts.
R2_PUBLIC_URL=
