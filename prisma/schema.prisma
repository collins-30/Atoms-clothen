// Fashion store — Prisma 6 + MySQL
// Converted from the Base44 entities. Notes sit above each model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum BannerType {
  HERO
  PROMO
  CRAFT
}

enum HeaderStyle {
  DEFAULT
  TINTED
  BORDERED
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ─────────────────────────────────────────────
// Auth.js (Prisma adapter) + User
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String? // null for Google-only accounts
  role           Role      @default(USER)
  phone          String?
  dateOfBirth    DateTime? @db.Date
  emailMarketing Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  reviews   ProductReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Used for email verification and password reset links.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Used by the storefront auth flow for email verification and password resets.
model AuthToken {
  id        String           @id @default(cuid())
  email     String
  purpose   AuthTokenPurpose
  tokenHash String
  attempts  Int              @default(0)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([email, purpose])
  @@index([tokenHash])
}

// Replaces the `addresses` array that lived inside the Base44 User record.
model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  gender       Gender
  parentId     String? // was `parent_slug`
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?       @db.Text
  sku          String?       @unique
  categoryId   String?
  gender       Gender
  images       Json // string[]  (R2 URLs)
  videoUrl     String?
  materials    String?       @db.Text
  care         String?       @db.Text
  status       ProductStatus @default(PUBLISHED)
  isNew        Boolean       @default(false)
  isBestseller Boolean       @default(false)
  isTrending   Boolean       @default(false)
  featured     Boolean       @default(false)
  collection   String?
  tags         Json // string[]
  colors       Json // { name: string; hex: string }[]
  sizes        Json // string[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  prices     ProductPrice[] // one row per market = "available in market"
  reviews    ProductReview[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id       String  @id @default(cuid())
  productId String
  color    String
  colorHex String?
  size     String
  sku      String  @unique
  stock    Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, color, size])
}

// ProductPrice doubles as the Product<->Market assignment.
//   - Row exists + available = true  -> sold in that market at `price`
//   - Row deleted / available = false -> removed from that market only
//   - Deleting the Product row removes it from every market.
// This replaces Product.markets (string[]) from Base44.
model ProductPrice {
  id        String  @id @default(cuid())
  productId String
  marketId  String
  price     Decimal @db.Decimal(10, 2)
  available Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([productId, marketId])
  @@index([marketId])
}

model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  userId       String
  orderId      String? // order that made this a verified purchase
  rating       Int // 1-5, validate with Zod
  title        String?
  body         String   @db.Text
  customerName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId]) // one review per customer per product
  @@index([productId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// Markets
// ─────────────────────────────────────────────

model Market {
  id             String @id @default(cuid())
  code           String @unique // "US", "CA", "EU", "AF"
  name           String
  currency       String // "USD"
  currencySymbol String @default("") // "$"
  active         Boolean @default(true)
  displayOrder   Int @default(0)

  prices          ProductPrice[]
  shippingOptions ShippingOption[]
}

// Replaces Market.shipping_options ({ id, price }[]). `code` is the old `id`
// (e.g. "standard", "express"). Checkout must look the price up here on the
// server rather than trusting a price sent by the browser.
model ShippingOption {
  id       String  @id @default(cuid())
  marketId String
  code     String
  price    Decimal @db.Decimal(10, 2)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, code])
}

// ─────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────

model Order {
  id          String        @id @default(cuid())
  orderNumber String        @unique
  userId      String?
  status      OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  shipping       Decimal @default(0) @db.Decimal(10, 2)
  tax            Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @default(0) @db.Decimal(10, 2)
  discountCode   String?

  currency       String
  currencySymbol String
  marketCode     String

  // Shipping address snapshot (copied at checkout, never changes afterwards)
  shipFullName   String
  shipEmail      String
  shipPhone      String?
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipRegion     String?
  shipPostalCode String
  shipCountry    String

  carrier        String?
  trackingNumber String?
  notes          String? @db.Text

  // Payment provider (Stripe now, Paystack later)
  paymentProvider  String? // "stripe" | "paystack"
  paymentSessionId String? @unique // makes the webhook idempotent: one order per session
  paymentIntentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  reviews ProductReview[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Replaces the `items` array inside Base44 Order. name/image/price are snapshots
// so old orders stay correct if a product is later edited or deleted.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  slug      String
  name      String
  image     String?
  color     String?
  size      String?
  qty       Int
  price     Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Discount {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType @default(PERCENT)
  value     Decimal      @default(0) @db.Decimal(10, 2)
  minOrder  Decimal      @default(0) @db.Decimal(10, 2)
  startDate DateTime?
  endDate   DateTime?
  active    Boolean      @default(true)
}

// ─────────────────────────────────────────────
// Content & appearance
// ─────────────────────────────────────────────

model Banner {
  id           String     @id @default(cuid())
  type         BannerType @default(PROMO)
  title        String
  subtitle     String?
  image        String?
  buttonText   String?
  link         String?
  active       Boolean    @default(true)
  displayOrder Int        @default(0)
}

// startDate/endDate are recurring "MM-DD" strings (e.g. "12-01" to "12-31"), same as Base44.
model Theme {
  id                  String      @id @default(cuid())
  name                String
  slug                String      @unique
  active              Boolean     @default(true)
  autoActivate        Boolean     @default(false)
  startDate           String?  @db.VarChar(5)
  endDate             String?  @db.VarChar(5)
  colorPrimary        String?
  colorSecondary      String?
  colorBackground     String?
  colorText           String?
  colorButton         String?
  headerStyle         HeaderStyle @default(DEFAULT)
  announcementEnabled Boolean     @default(false)
  announcementText    String?
  bannerImage         String?
  bannerHeading       String?
  bannerSubheading    String?
  bannerLink          String?
  decorations         Json // ("snow" | "hearts" | "sparkles" | "confetti")[]
  displayOrder        Int         @default(0)
}

// Single-row table. Always read/write the row with id = "default".
model StoreSettings {
  id            String @id @default("default")
  overrideTheme String @default("auto") // "auto" or a Theme.slug
}

// Your docs said the footer subscribe form didn't persist anything. This does.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
